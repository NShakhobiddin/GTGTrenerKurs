# Vercel → Project → Settings → Environment Variables bo'limiga shu qiymatlarni kiriting.
# Bu faylning o'zini to'ldirib GitHub'ga yuklamang.

# @BotFather bergan token
BOT_TOKEN=1234567890:AA...

# Arizalar boradigan chat ID. Administrator botga /id yuboradi va shu raqamni oladi.
# Guruhga yuborish uchun botni guruhga qo'shib, guruhda /id yozing (raqam minus bilan boshlanadi).
ADMIN_CHAT_ID=

# Mini App va menyu tugmasi ochadigan sayt manzili
SITE_URL=https://nshakhobiddin.github.io/GTGTrenerKurs/

# Webhook himoyasi: faqat harflar, raqamlar, _ va - (masalan: gt_secret_9f3k2)
WEBHOOK_SECRET=

# /api/setup sahifasini ochish uchun maxfiy kalit (o'zingiz o'ylab toping)
SETUP_KEY=

# Formani qabul qiladigan saytlar (vergul bilan). Vercel domeningiz avtomatik ruxsat etilgan.
ALLOWED_ORIGINS=https://nshakhobiddin.github.io
